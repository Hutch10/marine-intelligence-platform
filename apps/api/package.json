{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@marine/shared": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "seed:datasets": "npx tsx src/db/seed-datasets.ts",
    "ingest:live": "npx tsx src/workers/ingest-live-feeds.ts",
    "ingest:scheduler": "npx tsx src/workers/scheduler.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "tsx": "^4.7.0",
    "vitest": "^4.1.0"
  }
}
