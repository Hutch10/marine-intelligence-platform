# Marine API environment
# HTTP server port (default: 4000)
PORT=4000

# SQLite database path (relative to apps/api process working directory)
MARINE_DB_PATH=.data\marine.sqlite

# NOAA NDBC station IDs to ingest (comma-separated)
NDBC_STATION_IDS=41009,41010,41012,41013,41025,41044,42003,42019,42036,42040,42056

# NOAA Coral Reef Watch target regions (comma-separated)
CRW_TARGET_REGIONS=Southeast Florida,Florida Keys

# IOOS ERDDAP ingestion (opt-in, production-safe default is disabled)
ERDDAP_ENABLED=false
# ERDDAP_BASE_URL=https://erddap.ioos.us/erddap
# ERDDAP_DATASET_ID=gov_noaa_ndbc_sos
# Optional: restrict to specific station IDs (comma-separated); omit to ingest all available
# ERDDAP_STATION_IDS=41009,41010,41013
# ERDDAP_REGION_KEY=southeast-florida
# ERDDAP_LOOKBACK_HOURS=24
