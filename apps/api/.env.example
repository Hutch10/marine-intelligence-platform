# Marine API runtime environment template
#
# Deployments should set these values in the environment manager
# used by the runtime platform (for example: Render, Fly, or Docker).

# Optional custom SQLite path. If empty, the API uses its default resolver.
MARINE_DB_PATH=

# NOAA NDBC ingestion targets (comma-separated station IDs).
NDBC_STATION_IDS=46042,41009

# NOAA Coral Reef Watch ingestion targets (comma-separated region names).
CRW_TARGET_REGIONS=Great Barrier Reef,Caribbean

# IOOS ingestion gate. Keep false unless explicitly enabled per environment.
IOOS_ENABLED=false

# Optional single IOOS endpoint for all configured stations.
IOOS_SOURCE_URL=

# Optional IOOS station IDs (comma-separated). When set, station mode is used.
IOOS_STATION_IDS=

# Optional grouping key for IOOS station metrics and provenance records.
IOOS_REGION_KEY=ioos_region

# Optional IOOS endpoint list (comma-separated). Used when station IDs are not set.
IOOS_SOURCE_URLS=