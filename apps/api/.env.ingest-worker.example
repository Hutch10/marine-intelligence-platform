# Ingest worker environment (GitHub Actions, VM cron, or operator manual run).
# Copy to .env.ingest-worker.local — never commit secrets.
#
# Must match production Turso used by marine-intelligence-platform-api on Vercel.

NODE_ENV=production

# ── Turso (required for production activation) ────────────────────────────────
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# ── NOAA NDBC (required) ───────────────────────────────────────────────────
# Align with stations served on the dashboard (production example below).
NDBC_STATION_IDS=46042,41009

# ── NOAA Coral Reef Watch (required) ─────────────────────────────────────────
CRW_TARGET_REGIONS=Great Barrier Reef,Caribbean

# ── Optional: local SQLite for ingestion report rows only ───────────────────
# Not shared with Vercel. Feed-health on Turso-only API may stay empty; see
# docs/telemetry-activation/ARCHITECTURE.md#split-brain-operational-note.
# MARINE_DB_PATH=.data/marine.sqlite

# ── Auxiliary sources (default off) ─────────────────────────────────────────
IOOS_ENABLED=false
IOOS_SOURCE_URL=
IOOS_STATION_IDS=
IOOS_REGION_KEY=ioos_region
IOOS_SOURCE_URLS=

ERDDAP_ENABLED=false
# ERDDAP_BASE_URL=https://erddap.ioos.us/erddap
# ERDDAP_DATASET_ID=gov_noaa_ndbc_sos
# ERDDAP_STATION_IDS=
# ERDDAP_REGION_KEY=southeast-florida
# ERDDAP_LOOKBACK_HOURS=24

# ── Scheduler-only overrides (ingest:scheduler, not ingest:live) ─────────────
# SCHEDULER_NDBC_INTERVAL_MS=1200000
# SCHEDULER_CRW_INTERVAL_MS=7200000
# SCHEDULER_IOOS_INTERVAL_MS=2700000
# SCHEDULER_ERDDAP_INTERVAL_MS=2700000
