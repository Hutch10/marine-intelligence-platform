{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web/*"]
    },
    "types": ["node", "vitest/globals"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "../web/lib/api/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
