# Marine Intelligence API base URL
# The web app calls apps/api over HTTP. Set this to the running API server address.
# Default: http://localhost:4000 (used when env var is absent)
MARINE_API_BASE_URL=http://localhost:4000

# Internal server-only API key used by Next.js API routes under /api/marine-intelligence/*
# Do not expose in NEXT_PUBLIC_* variables.
MARINE_INTERNAL_API_KEY=
